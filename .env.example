# ============================================
# GitHub Analytics Dashboard – Environment Variables
# Copy this file to .env and fill with your real values.
# NEVER commit .env to the repository.
# ============================================

# ----------------------------
# GitHub API
# ----------------------------
GITHUB_TOKEN=your_github_token_here

# ----------------------------
# ClickHouse – Application (native protocol)
# ----------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9001
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=github_analytics

# ----------------------------
# JWT Authentication
# ----------------------------
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------
# Scheduler (minutes / hours)
# ----------------------------
ETL_SCHEDULE_MINUTES=60
MODEL_RETRAINING_SCHEDULE_HOURS=24

# ----------------------------
# Google Cloud (optional)
# ----------------------------
GCP_PROJECT_ID=your-gcp-project
GCP_DATASET_ID=github_analytics
GOOGLE_APPLICATION_CREDENTIALS=./credentials/github-analytics-xxxx.json
GITHUB_RATE_LIMIT_DELAY=1

# ----------------------------
# Grafana auto-setup
# ----------------------------
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ----------------------------
# Metabase add‑on (optional)
# These variables are used ONLY by Metabase.
# They do NOT override the application's ClickHouse connection.
# ----------------------------
METABASE_PORT=3002
METABASE_CLICKHOUSE_HOST=clickhouse          # Docker service name
METABASE_CLICKHOUSE_PORT=8123                # HTTP port
METABASE_CLICKHOUSE_DATABASE=github_analytics
METABASE_CLICKHOUSE_USER=metabase_user
METABASE_CLICKHOUSE_PASSWORD=secure_password_here
MB_ADMIN_EMAIL=admin@metabase.com
MB_ADMIN_PASSWORD=admin123

# ----------------------------
# PostgreSQL for Metabase metadata
# ----------------------------
POSTGRES_USER=metabase_user
POSTGRES_PASSWORD=metabase_pass

# ----------------------------
# Environment (local / production)
# ----------------------------
ENVIRONMENT=local